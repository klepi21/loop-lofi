// === Clip ===

#[test]
fun clip_mint() {
    let mut s = setup();
    let mut clk = clock::create_for_testing(s.ctx());
    clk.set_for_testing(42);
    s.next_tx(USER);
    clip::mint_clip(b"blob123".to_string(), b"Triple hit".to_string(), 3, b"Frost Peak".to_string(), &clk, s.ctx());
    s.next_tx(USER);
    let c = s.take_from_sender<Clip>();
    assert!(clip::blob_id(&c) == b"blob123".to_string());
    assert!(clip::created_ms(&c) == 42);
    assert!(clip::kills(&c) == 3);
    s.return_to_sender(c);
    clk.destroy_for_testing();
    s.end();
}
