#[test]
fun set_base_image_changes_new_mints() {
    let mut s = setup();
    s.next_tx(ADMIN);
    let mut reg = s.take_shared<Registry>();
    let cap = s.take_from_sender<AdminCap>();
    yeti::set_base_image(&cap, &mut reg, b"https://cdn.example/y/".to_string());
