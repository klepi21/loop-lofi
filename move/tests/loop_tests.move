    s.return_to_sender(cap);
    ts::return_shared(reg);
    s.end();
}

// === Tournament ===

fun make_tournament(s: &mut ts::Scenario) {
    s.next_tx(ADMIN);
    let cap = s.take_from_sender<AdminCap>();
    tournament::create(&cap, b"Cup".to_string(), 1000, 2000, s.ctx());
    s.return_to_sender(cap);
}

#[test]
fun tournament_flow() {
    let mut s = setup();
    make_tournament(&mut s);
    let mut clk = clock::create_for_testing(s.ctx());
    clk.set_for_testing(1500);

    s.next_tx(USER);
    let mut t = s.take_shared<Tournament>();
    tournament::fund(&mut t, coin::mint_for_testing<SUI>(1000, s.ctx()), s.ctx());
    tournament::join(&mut t, &clk, s.ctx());
    ts::return_shared(t);

    s.next_tx(USER2);
    let mut t = s.take_shared<Tournament>();
    tournament::join(&mut t, &clk, s.ctx());
    assert!(tournament::entrants(&t).length() == 2);
    ts::return_shared(t);

    // Admin hands GameCap to the game server, which pays out.
    s.next_tx(ADMIN);
    let g = s.take_from_sender<GameCap>();
    transfer::public_transfer(g, USER2);
    s.next_tx(USER2);
    let g = s.take_from_sender<GameCap>();
    let mut t = s.take_shared<Tournament>();
    tournament::payout(&g, &mut t, vector[USER, USER2], vector[600, 300], s.ctx());
    assert!(tournament::is_paid(&t));
    assert!(tournament::pot_value(&t) == 100);
    ts::return_shared(t);
    s.return_to_sender(g);

    s.next_tx(USER);
    let c = s.take_from_sender<Coin<SUI>>();
    assert!(c.value() == 600);
    s.return_to_sender(c);

    // Admin sweeps the rest.
    s.next_tx(ADMIN);
    let cap = s.take_from_sender<AdminCap>();
    let mut t = s.take_shared<Tournament>();
    tournament::sweep(&cap, &mut t, s.ctx());
    assert!(tournament::pot_value(&t) == 0);
    ts::return_shared(t);
    s.return_to_sender(cap);

    clk.destroy_for_testing();
    s.end();
}

#[test, expected_failure(abort_code = tournament::EAlreadyJoined)]
fun tournament_no_duplicates() {
    let mut s = setup();
    make_tournament(&mut s);
    let mut clk = clock::create_for_testing(s.ctx());
    clk.set_for_testing(1500);
    s.next_tx(USER);
    let mut t = s.take_shared<Tournament>();
    tournament::join(&mut t, &clk, s.ctx());
    tournament::join(&mut t, &clk, s.ctx());
    abort 0
}

