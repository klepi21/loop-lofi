const ADMIN: address = @0xAD;
const USER: address = @0xB0B;
const USER2: address = @0xCAFE;

// Test vector generated by scripts/gen-vector.mjs with @mysten/sui 2.39.1:
// seed = 32 bytes of 0x07, yeti id = 0xa11ce, kills 12, deaths 3, won true, xp 450, seq 1.
const PUBKEY: vector<u8> = x"ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c";
const MESSAGE: vector<u8> = x"00000000000000000000000000000000000000000000000000000000000a11ce0c00000000000000030000000000000001c2010000000000000100000000000000";
const SIG: vector<u8> = x"ccf93de5ae4e5070f7128fb935920269db5d40659987d9b825053f0e14c0379e52db6189be2875cd4cbbfb4ac57d55b97a4304cc71f61fddc77b39bee566fd03";

#[test]
fun message_layout_matches_js() {
    let msg = yeti::match_message(@0xa11ce, 12, 3, true, 450, 1);
    assert!(msg.length() == 65);
    assert!(msg == MESSAGE);
}

#[test]
fun js_signature_verifies() {
    let msg = yeti::match_message(@0xa11ce, 12, 3, true, 450, 1);
    assert!(ed25519::ed25519_verify(&SIG, &PUBKEY, &msg));
    // Tampered field must fail.
    let bad = yeti::match_message(@0xa11ce, 13, 3, true, 450, 1);
    assert!(!ed25519::ed25519_verify(&SIG, &PUBKEY, &bad));
}

#[test]
fun level_curve() {
    assert!(yeti::level_for(0) == 1);
    assert!(yeti::level_for(299) == 1);
    assert!(yeti::level_for(300) == 2);
    assert!(yeti::level_for(450) == 2);
    assert!(yeti::level_for(1_000_000_000) == 100);
}

fun setup(): ts::Scenario {
    let mut s = ts::begin(ADMIN);
    yeti::init_for_testing(s.ctx());
    clip::init_for_testing(s.ctx());
    s
}

#[test]
fun init_creates_everything() {
    let mut s = setup();
    s.next_tx(ADMIN);
    let reg = s.take_shared<Registry>();
    assert!(yeti::minted(&reg) == 0);
    assert!(yeti::base_image(&reg) == b"https://loop-lofi.vercel.app/nft/".to_string());
    ts::return_shared(reg);
    let p = s.take_shared<TransferPolicy<Yeti>>();
    ts::return_shared(p);
    let pc = s.take_from_sender<TransferPolicyCap<Yeti>>();
    s.return_to_sender(pc);
    let a = s.take_from_sender<AdminCap>();
    s.return_to_sender(a);
    let g = s.take_from_sender<GameCap>();
    s.return_to_sender(g);
    s.end();
}

#[test]
fun mint_sets_image_and_counts() {
    let mut s = setup();
    s.next_tx(USER);
    let mut reg = s.take_shared<Registry>();
    yeti::mint(&mut reg, b"Lofi".to_string(), 7, s.ctx());
    // Greek name: 14 characters, 28 bytes, must be accepted.
    yeti::mint(&mut reg, b"\xce\x93\xce\x99\xce\x9f\xce\xa1\xce\x93\xce\x9f\xce\xa3\xce\x93\xce\x99\xce\x9f\xce\xa1\xce\x93\xce\x9f\xce\xa3".to_string(), 0, s.ctx());
    assert!(yeti::minted(&reg) == 2);
    ts::return_shared(reg);
    s.next_tx(USER);
    let ids = s.ids_for_sender<Yeti>();
    assert!(ids.length() == 2);
    let y = s.take_from_sender_by_id<Yeti>(ids[0]);
    let y2 = s.take_from_sender_by_id<Yeti>(ids[1]);
    let lofi = if (yeti::skin(&y) == 7) &y else &y2;
    assert!(yeti::image_url(lofi) == b"https://loop-lofi.vercel.app/nft/7.png".to_string());
    assert!(yeti::level(lofi) == 1);
    s.return_to_sender(y);
    s.return_to_sender(y2);
    s.end();
}

